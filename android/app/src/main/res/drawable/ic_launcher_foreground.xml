<?xml version="1.0" encoding="utf-8"?>
<!--
  Lapisan depan ikon adaptif: pembatas buku putih di atas latar ungu.

  Sebelumnya berupa buku terbuka, tapi bentuk itu menyiratkan "sedang membaca",
  bukan "menandai tempat berhenti" — sementara justru itu inti aplikasinya.
  Pembatas buku menyampaikannya langsung dan tetap terbaca pada ukuran kecil.

  Ditulis sebagai vector drawable, bukan PNG per kepadatan layar, supaya proyek
  ini tidak perlu menyimpan aset biner sama sekali.

  Kanvas ikon adaptif berukuran 108x108dp dengan zona aman di bagian tengah
  72x72dp. Gambar digambar dalam koordinat 24x24 lalu diskalakan 2,333x dan
  digeser 26dp, sehingga menempati 26..82 — masih di dalam zona aman.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="26"
        android:translateY="26"
        android:scaleX="2.3333"
        android:scaleY="2.3333">

        <!-- Badan pembatas dengan takik segitiga di bawah. Sudut atas sedikit
             dibulatkan agar tidak terlihat kaku pada mask berbentuk lingkaran. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M7,2.5 L17,2.5 A1.5,1.5 0 0,1 18.5,4 L18.5,21.5 L12,16.8 L5.5,21.5 L5.5,4 A1.5,1.5 0 0,1 7,2.5 Z" />
    </group>
</vector>
